# Copy to .env.local to point the app at another EdSpace server.
# Defaults to https://edville.space when unset.
#
# Android emulator → a server on this machine:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3999
#
# Phone on the same Wi-Fi → a server on this machine (start it with HOST=0.0.0.0):
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3999
